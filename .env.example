# Compose supplies local application database and ingestion MinIO defaults.
# Grafana permits anonymous access. Copy this file to .env before starting the stack.
# Container APIs verify Google ID tokens issued for this public OAuth client ID.
GOOGLE_CLIENT_ID=replace-with-public-oauth-client-id.apps.googleusercontent.com
# Select inference profiles available to your Bedrock account.
MAIN_MODEL_ID=global.openai.gpt-5.6-terra
UTILITY_MODEL_ID=global.openai.gpt-5.6-luna
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Set only with temporary AWS credentials.
AWS_SESSION_TOKEN=

# Langfuse: required stack credentials. These are shared local development examples.
# Use your own values for a deployed instance; the user password needs at least 8 characters.
LANGFUSE_CLICKHOUSE_PASSWORD=horizon-local-clickhouse
LANGFUSE_DATABASE_PASSWORD=horizon-local-langfuse-db
LANGFUSE_ENCRYPTION_KEY=fb0b963b8b95643cf26772a10510e8500fb4413674de93aec7385c25d69a0c6a
LANGFUSE_MINIO_PASSWORD=horizon-local-langfuse-minio
LANGFUSE_MINIO_USER=langfuse-admin
LANGFUSE_NEXTAUTH_SECRET=bc7d5581202bd27ff1c7f92378df9a9de594b1891b198dd955a4f1454e26314a
LANGFUSE_PUBLIC_KEY=pk-lf-horizon-local
LANGFUSE_REDIS_PASSWORD=horizon-local-redis
LANGFUSE_SALT=fd54a2c44047cac906a9f2d9eabdca76
LANGFUSE_SECRET_KEY=sk-lf-horizon-local-development
LANGFUSE_USER_EMAIL=admin@admin.com
LANGFUSE_USER_PASSWORD=admin.admin69
