# REQUIRED: deployment topology and secrets
INGESTION_ENVIRONMENT_NAME=local
INGESTION_BIND_HOST=127.0.0.1
INGESTION_BIND_PORT=8081
INGESTION_FRONTEND_ORIGIN=http://localhost:3000
INGESTION_AWS_REGION=eu-west-1
INGESTION_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
INGESTION_GOOGLE_CLIENT_ID=replace-with-public-oauth-client-id
INGESTION_MINIO_ENDPOINT=http://localhost:9000
INGESTION_MINIO_BUCKET=horizon-documents
INGESTION_DATABASE_DSN=postgresql://ingestion_login:replace-me@localhost:5432/horizon
INGESTION_MINIO_ACCESS_KEY=replace-me
INGESTION_MINIO_SECRET_KEY=replace-me

# OVERRIDABLE: policy in config/base.yaml and config/services/ingestion.yaml
# INGESTION_WINDOW_SIZE=2000
# INGESTION_OVERLAP=200
# INGESTION_VENDOR_CONCURRENCY=4
# INGESTION_WORKER_CONCURRENCY=4
# INGESTION_MAX_CALL_ATTEMPTS=3
# INGESTION_RETRY_INITIAL_BACKOFF_SECONDS=0.5
# INGESTION_RETRY_MAX_BACKOFF_SECONDS=10
# INGESTION_MAX_UPLOAD_BYTES=52428800

# OPTIONAL: static Bedrock credentials (unset: the default AWS credential chain)
INGESTION_AWS_ACCESS_KEY_ID=
INGESTION_AWS_SECRET_ACCESS_KEY=
# Set only with temporary credentials.
INGESTION_AWS_SESSION_TOKEN=

# OPTIONAL: diagnostics and process identity
INGESTION_OTLP_ENDPOINT=
INGESTION_SERVICE_INSTANCE_ID=
