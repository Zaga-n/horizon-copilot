# REQUIRED: deployment topology and model profiles
ENVIRONMENT_NAME=local
BIND_HOST=127.0.0.1
BIND_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
AWS_REGION=eu-west-1
MAIN_MODEL_ID=global.openai.gpt-5.6-terra
UTILITY_MODEL_ID=global.openai.gpt-5.6-luna
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
GOOGLE_CLIENT_ID=replace-with-public-oauth-client-id.apps.googleusercontent.com
# REQUIRED: secrets (runtime roles, never migration roles)
DATABASE_DSN=postgresql://chat_runtime:replace-me@localhost:5432/horizon
CHECKPOINT_DATABASE_DSN=postgresql://chat_runtime:replace-me@localhost:5432/horizon

# OVERRIDABLE: YAML policy; production cannot select local identity
# IDENTITY_MODE=google
# RETENTION_DAYS=30
# MAINTENANCE_INTERVAL_SECONDS=3600
# MAIN_REASONING_EFFORT=low
# TURN_DEADLINE_SECONDS=120
# TURN_LEASE_SECONDS=150
# MAX_PHYSICAL_MODEL_ATTEMPTS=24
# HORIZON_CONFIG_DIR=/app/config
# CAPTURE_AI_CONTENT=true  # local YAML enables this; other environments default to false

# OPTIONAL: unset OTLP disables export
# OTLP_ENDPOINT=http://localhost:4318
# SERVICE_INSTANCE_ID=chat-1
